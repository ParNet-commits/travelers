# Copy to .env.local (never commit it). In production set these in Vercel > Project > Settings > Environment Variables.
# Server-only: NEVER prefix any of these with VITE_ (VITE_ variables are shipped to every browser).
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Long random string (24+ chars) that unlocks the Control Room admin actions.
TV_ADMIN_TOKEN=
# Contact email sent in the OpenStreetMap User-Agent (Nominatim usage policy).
TV_CONTACT_EMAIL=

# Optional overrides (defaults shown)
# TV_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# TV_MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
# TV_MODEL_ESCALATION=nvidia/Nemotron-3-Ultra-550b-a55b
# TV_MODEL_ALLOWLIST=           # extra model ids the Control Room may switch to (comma-separated)
# TV_JSON_MODE=json_object      # json_schema | json_object | none  (set after npm run probe:models)
# TV_LIVE_ENABLED=true          # kill switch: false = replay only, zero spend
# TV_MAX_USD_PER_RUN=0.10
# TV_RUNS_PER_IP_PER_HOUR=6
# TV_REPLAY_SPEED=1.5
